{
  "name": "curais",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:patient": "npm run dev --workspace=@curais/patient",
    "dev:doctor": "npm run dev --workspace=@curais/doctor",
    "build": "npm run build --workspaces --if-present",
    "build:patient": "npm run build --workspace=@curais/patient",
    "build:doctor": "npm run build --workspace=@curais/doctor",
    "lint": "npm run lint --workspaces --if-present",
    "api:dev": "cd services/api && go run ./cmd/api",
    "api:test": "cd services/api && go test ./..."
  }
}
